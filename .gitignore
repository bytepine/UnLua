# ============================================
# UnLua — UE 插件 .gitignore
# ============================================

# Visual Studio
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# 官方随源码分发的 Lua 预编译库（各平台 lib-c / lib-cpp）
!Source/ThirdParty/Lua/**/lib-c/**/*.a
!Source/ThirdParty/Lua/**/lib-c/**/*.lib
!Source/ThirdParty/Lua/**/lib-c/**/*.dll
!Source/ThirdParty/Lua/**/lib-c/**/*.dylib
!Source/ThirdParty/Lua/**/lib-c/**/*.so
!Source/ThirdParty/Lua/**/lib-cpp/**/*.a
!Source/ThirdParty/Lua/**/lib-cpp/**/*.lib
!Source/ThirdParty/Lua/**/lib-cpp/**/*.dll
!Source/ThirdParty/Lua/**/lib-cpp/**/*.dylib
!Source/ThirdParty/Lua/**/lib-cpp/**/*.so

# Executables
*.exe
*.out
*.app
*.ipa

# UE 可重新生成的工程文件
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# 插件构建产物（/release/ 仅忽略仓库根目录，避免误伤 lib-c/Win64/Release 等预编译库）
Binaries/
Intermediate/
Build/
/release/

# UBT / MSBuild 中间文件
obj/
bin/

# OS 生成文件
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
*.tmp
*.bak
*.swp
*~

__pycache__/
*.pyc
.pytest_cache/
